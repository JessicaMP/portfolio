---
import SectionHeading from './SectionHeading.astro';
import SocialIcon from './SocialIcon';
import { Mail, Phone, MapPin, Languages, Layers } from 'lucide-react';
import { getData, type Lang } from '@/data/i18n';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const { profile, ui } = getData(lang);
import { rich } from '@/data/i18n';

const info = [
  { label: ui.about.contact, value: profile.email, href: `mailto:${profile.email}`, Icon: Mail, wide: true },
  { label: ui.about.phone, value: profile.phone, href: profile.phoneHref, Icon: Phone },
  { label: ui.about.location, value: profile.location, Icon: MapPin },
  { label: ui.about.languages, value: profile.languages, Icon: Languages, wide: true },
  { label: ui.about.stack, value: profile.mainStack, Icon: Layers, wide: true },
];

const socials = [
  { name: 'linkedin', label: 'LinkedIn', href: profile.linkedin },
  { name: 'github', label: 'GitHub', href: profile.github },
  { name: 'email', label: 'Email', href: `mailto:${profile.email}` },
] as const;
---

<section id="sobre-mi" class="relative overflow-hidden bg-soft py-24 sm:py-32">

  <div class="container-page grid gap-14 lg:grid-cols-12 lg:gap-16">
    <!-- Texto -->
    <div class="lg:col-span-6 xl:col-span-7">
      <SectionHeading tag={ui.about.tag} title={`${ui.about.greeting} ${profile.name}`} align="left" />
      <div class="space-y-5 pt-8">
        {profile.about.map((p, i) => (
          <p class="reveal text-[17px] leading-8 text-muted" style={`--reveal-delay:${120 + i * 120}ms`} set:html={rich(p)}></p>
        ))}
      </div>

      <div class="reveal flex flex-wrap items-center gap-3 pt-10" style="--reveal-delay:360ms">
        {socials.map((s) => (
          <a
            href={s.href}
            target={s.name === 'email' ? undefined : '_blank'}
            rel="noopener"
            aria-label={s.label}
            class="group inline-flex h-12 items-center gap-2.5 rounded-full border border-line-strong bg-white/80 px-5 text-sm font-semibold text-ink shadow-sm backdrop-blur transition duration-300 ease-out-soft hover:-translate-y-0.5 hover:border-transparent hover:bg-primary hover:text-white hover:shadow-lg hover:shadow-primary/25"
          >
            <span class="text-primary transition-colors duration-300 group-hover:text-white">
              <SocialIcon name={s.name} size={18} />
            </span>
            {s.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Tarjetas de información -->
    <dl class="grid grid-cols-1 gap-4 self-center sm:grid-cols-2 lg:col-span-6 xl:col-span-5">
      {info.map((item, i) => (
        <div
          class:list={[
            'reveal group relative rounded-[var(--radius-card)] border border-line bg-white/80 p-6 shadow-[0_8px_30px_-12px_rgb(3_4_94/0.12)] backdrop-blur transition duration-500 ease-out-soft hover:-translate-y-1 hover:border-accent/40 hover:shadow-[0_20px_40px_-16px_rgb(0_119_182/0.35)]',
            item.wide && 'sm:col-span-2',
          ]}
          style={`--reveal-delay:${i * 90}ms`}
        >
          <div class="flex items-start gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-sky/30 text-primary transition duration-500 ease-out-soft group-hover:rotate-[-6deg] group-hover:bg-primary group-hover:text-white">
              <item.Icon size={20} aria-hidden="true" />
            </span>
            <div class="min-w-0">
              <dt class="text-xs font-semibold tracking-[0.12em] text-muted uppercase">{item.label}</dt>
              <dd class="pt-1.5 text-[15px] leading-6 font-semibold text-ink">
                {item.href ? (
                  <a href={item.href} class="break-words transition-colors duration-300 hover:text-primary">{item.value}</a>
                ) : (
                  item.value
                )}
              </dd>
            </div>
          </div>
        </div>
      ))}
    </dl>
  </div>
</section>
