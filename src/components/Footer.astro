---
import { ArrowUpRight, PhoneCall, MailOpen, MapPin } from 'lucide-react';
import SocialIcon from './SocialIcon';
import { getData, type Lang } from '@/data/i18n';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const { profile, ui } = getData(lang);

const contacts = [
  { Icon: PhoneCall, label: ui.footer.call, value: profile.phone, href: profile.phoneHref },
  { Icon: MailOpen, label: ui.footer.mail, value: profile.email, href: `mailto:${profile.email}` },
  { Icon: MapPin, label: ui.footer.remote, value: profile.location },
];

const socials = [
  { name: 'linkedin', href: profile.linkedin },
  { name: 'github', href: profile.github },
  { name: 'email', href: `mailto:${profile.email}` },
] as const;

const year = new Date().getFullYear();
---

<footer id="contacto" class="bg-ink">
  <div class="container-page grid items-center gap-7 py-16 lg:grid-cols-2">
    <div>
      <h2 class="max-w-[576px] text-[32px] leading-[1.5] font-bold text-white sm:text-[40px] sm:leading-[60px]">
        {ui.footer.title}
      </h2>
      <div class="pt-14">
        <a
          href={`mailto:${profile.email}`}
          class="inline-flex h-14 items-center gap-2.5 rounded-full bg-primary px-8 font-semibold text-white shadow-lg shadow-primary/30 transition duration-300 ease-out-soft hover:-translate-y-0.5 hover:bg-white hover:text-ink"
        >
          {ui.footer.cta}
          <ArrowUpRight size={20} aria-hidden="true" />
        </a>
      </div>
    </div>

    <!-- Ilustración propia (reemplaza la ilustración 3D del template) -->
    <div class="relative mx-auto aspect-[610/516] w-full max-w-[610px]" aria-hidden="true">
      <svg viewBox="0 0 610 516" class="absolute inset-0 size-full" fill="none">
        <path d="M330 90c-60-30-130-20-180 20" stroke="#7780a1" stroke-width="3" stroke-dasharray="12 12" />
        <path d="M156 102l-10 12 16 2" stroke="#7780a1" stroke-width="3" />
        <path d="M250 110c-40 80-20 190 60 250" stroke="#7780a1" stroke-width="3" stroke-dasharray="12 12" />
      </svg>
      <div class="absolute top-[12%] right-[8%] w-[62%] overflow-hidden rounded-3xl border-2 border-white/10 bg-navy shadow-2xl">
        <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
          <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
          <span class="size-2.5 rounded-full bg-accent"></span>
          <span class="size-2.5 rounded-full bg-[#28c840]"></span>
        </div>
        <div class="space-y-3 p-5">
          <span class="block h-3 w-3/4 rounded-full bg-primary/70"></span>
          <span class="block h-3 w-1/2 rounded-full bg-white/15"></span>
          <span class="block h-3 w-2/3 rounded-full bg-accent/70"></span>
          <span class="block h-3 w-5/6 rounded-full bg-white/15"></span>
          <span class="block h-3 w-1/3 rounded-full bg-primary/40"></span>
        </div>
      </div>
      <div class="bg-brand-radial absolute bottom-[10%] left-[22%] flex size-[30%] items-center justify-center rounded-[2rem] text-5xl font-extrabold text-white shadow-2xl sm:text-6xl">
        JM
      </div>
      <div class="absolute right-[18%] bottom-[18%] size-[12%] rotate-12 bg-accent"></div>
    </div>
  </div>

  <!-- Banda violeta con curva -->
  <div class="relative bg-primary pt-24">
    <svg class="absolute -top-px left-0 h-12 w-full text-ink sm:h-24" viewBox="0 0 1512 96" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 0h1512v96C1100 -10 412 -10 0 96z" fill="currentColor" />
    </svg>

    <div class="container-page relative">
      <ul class="grid gap-7 md:grid-cols-3">
        {contacts.map(({ Icon, label, value, href }) => (
          <li>
            <Icon size={40} strokeWidth={1.25} className="text-white" aria-hidden="true" />
            <p class="pt-7 text-sm leading-5 text-white/80">{label}</p>
            <p class="pt-3 text-lg leading-7 font-semibold break-all text-white sm:break-normal">
              {href ? <a href={href} class="hover:underline">{value}</a> : value}
            </p>
          </li>
        ))}
      </ul>

      <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t-2 border-white/12 py-5 sm:flex-row sm:items-center">
        <p class="text-sm leading-5 text-white">© {year} {profile.name}. {ui.footer.rights}</p>
        <ul class="flex gap-3.5">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.name === 'email' ? undefined : '_blank'}
                rel="noopener"
                aria-label={s.name}
                class="block text-white transition hover:text-accent"
              >
                <SocialIcon name={s.name} size={24} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</footer>
