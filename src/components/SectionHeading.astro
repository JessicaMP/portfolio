---
import { Sparkles } from 'lucide-react';

interface Props {
  tag: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  dark?: boolean;
}

const { tag, title, subtitle, align = 'center', dark = false } = Astro.props;
const centered = align === 'center';
---

<div class:list={['reveal flex flex-col', centered ? 'items-center text-center' : 'items-start']}>
  <p
    class:list={[
      'inline-flex h-10 items-center gap-2 rounded-full px-4 text-xs leading-5 font-semibold tracking-[0.14em] uppercase ring-1 transition-colors duration-300',
      dark ? 'bg-white/10 text-sky ring-white/15' : 'bg-sky/30 text-primary ring-primary/15',
    ]}
  >
    <Sparkles size={15} aria-hidden="true" />
    {tag}
  </p>
  <h2
    class:list={[
      'pt-6 text-3xl leading-tight font-bold tracking-tight sm:text-4xl',
      dark ? 'text-white' : 'text-ink',
    ]}
  >
    {title}
  </h2>
  {subtitle && (
    <p class:list={['pt-5 text-base leading-7 text-muted', centered && 'max-w-[708px]']}>{subtitle}</p>
  )}
</div>
